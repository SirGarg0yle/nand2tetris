// File name: projects/3/a/RAM8.hdl
/**
 * Memory of eight 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM8 {
    IN in[16], load, address[3];
    OUT out[16];

    PARTS:
    DMux8Way(in=load , sel=address , a=v1 , b=v2 , c=v3 , d=v4 , e=v5 , f=v6 , g=v7 , h=v8 );

    Register(in=in , load=v1 , out=w1 );
    Register(in=in , load=v2 , out=w2 );
    Register(in=in , load=v3 , out=w3 );
    Register(in=in , load=v4 , out=w4 );
    Register(in=in , load=v5 , out=w5 );
    Register(in=in , load=v6 , out=w6 );
    Register(in=in , load=v7 , out=w7 );
    Register(in=in , load=v8 , out=w8 );

    Mux8Way16(a=w1 , b=w2 , c=w3 , d=w4 , e=w5 , f=w6 , g=w7 , h=w8 , sel=address , out=out );
}
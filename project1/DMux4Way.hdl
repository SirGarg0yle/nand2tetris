// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    Not(in=sel[0], out=nsel0);
    Not(in=sel[1], out=nsel1);
    And(a=nsel0, b=nsel1, out=w1);
    DMux(in=in, sel=w1 , a=w2, b=a);
    And(a=sel[0], b=nsel1, out=w3);
    DMux(in=in, sel=w3, a=w4, b=b);
    And(a=nsel0, b=sel[1], out=w5);
    DMux(in=in, sel=w5, a=w6, b=c);
    And(a=sel[0], b=sel[1], out=w7);
    DMux(in=in, sel=w7, a=w8, b=d);
}
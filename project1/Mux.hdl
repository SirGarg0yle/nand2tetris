// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not(in=a, out=nota);
    Not(in=b, out=notb);
    Not(in=sel, out=notsel);

    And(a=nota, b=b, out=w1);
    And(a=w1, b=sel, out=w2);

    And(a=a, b=notb, out=w3);
    And(a=w3, b=notsel, out=w4);

    And(a=a, b=b, out=w5);
    And(a=w5, b=notsel, out=w6);

    And(a=w5, b=sel, out=w7);

    Or(a=w2 , b=w4 , out=w8);
    Or(a=w6 , b=w7 , out=w9);

    Or(a=w8, b=w9 , out=out);
}